# Skopiuj ten plik jako .env i uzupelnij wartosci.
# SECRET_KEY i ALGORITHM MUSZA byc identyczne jak w auth-microservice,
# bo ten serwis tylko weryfikuje tokeny JWT wystawione przez auth.
SECRET_KEY=change-me-to-the-same-secret-as-auth-microservice
ALGORITHM=HS256

# Lokalnie (poza Dockerem). W docker-compose ta wartosc jest nadpisywana.
DATABASE_URL=sqlite+aiosqlite:///./projects.db

# Lista domen (po przecinku) albo * dla dev.
BACKEND_CORS_ORIGINS=*
